# Kubernetes and Helm Provider
kubernetes_config_path = "~/.kube/harbor-config"
Kubernetes_config_context = "admin@harbor"
# Must match node_data.hostname of the proxmox module
kubernetes_node_name = "kubernetes-harbor"

# Harbor
harbor_admin_password = "supersecretpassword"
harbor_domain = "harbor.local"
harbor_url = "https://harbor.local"

# Docker Hub
docker_hub_username = "your-user-name"
docker_hub_password = "your-access-token"
docker_hub_email    = "me@example.com"

# GitHub, optional, if you do not specify one of the variables the GitHub registry cache will not be created
github_username = "your-user-name"
github_password = "your-access-token"

# Cilium Load Balancer. The Gateway all applications are published through gets the first
# address of this range, so harbor_domain has to resolve to it.
cilium_load_balancer_ip_range_start = "192.168.1.17"
cilium_load_balancer_ip_range_stop  = "192.168.1.19"

# CA, optional. The certificate authority is generated by OpenTofu, these are the defaults.
# ca_name                        = "Harbor"
# root_ca_validity_hours         = 87600
# intermediate_ca_validity_hours = 43800
